# Copy this file to .env for local development. Never commit the real .env file.

# --- Core ---
SECRET_KEY=change-me-to-a-random-50-character-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# IS_PRODUCTION gates HTTPS redirects, secure cookies, HSTS, and the hashed/minified static
# files storage. Leave unset (false) for local development. render.yaml sets this to "true".
IS_PRODUCTION=False

# --- Database ---
# Leave unset locally to use a SQLite file (db.sqlite3) with zero setup. In production this MUST
# point at PostgreSQL, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/nova_ctf
# DATABASE_URL=

# --- Team settings ---
DEFAULT_TEAM_SIZE_LIMIT=5
CONTACT_EMAIL=contact@novacybernetwork.org

# --- Rate limiting ---
RATELIMIT_ENABLE=True

# --- Email (password resets) ---
# Leave EMAIL_HOST unset to print reset emails to the console instead of sending them — fine for
# local development. Fill these in for a real deployment if you want password-reset emails to
# actually be delivered.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=NOVA Cyber Network <noreply@novacybernetwork.org>

# --- Initial administrator bootstrap (used by `python manage.py ensure_admin`) ---
# Safe to leave set permanently: ensure_admin only creates the account once and never resets an
# existing account's password on subsequent runs.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.org
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password
